OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
TAVILY_API_KEY=
JWT_SECRET=replace-this-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
# Optional locally (uses synapse.db when empty). Required on Vercel:
# Supabase > Connect > Transaction pooler connection string (port 6543).
DATABASE_URL=
# Payments (Razorpay > Account & Settings > API Keys). Use rzp_test_ keys
# while testing; leave empty to show plans without taking payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Webhooks: URL https://<backend>/api/billing/webhook, events
# payment.captured, order.paid, subscription.activated, subscription.charged,
# subscription.cancelled, subscription.halted, and a secret you choose.
RAZORPAY_WEBHOOK_SECRET=
# Auto-pay: Razorpay > Subscriptions > Plans IDs (plan_...). When a plan's ID
# is set, buying it starts an auto-renewing subscription; when empty, it is
# a one-time payment for 30 / 365 days.
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_MAX_MONTHLY=
RAZORPAY_PLAN_MAX_ANNUAL=
# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type Web).
# The same value goes in frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# One-time codes by email (forgot password, sign in with a code). Any SMTP service:
#   Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#          SMTP_PASSWORD=<16-letter app password from myaccount.google.com/apppasswords>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# One-time codes by text message: Twilio Verify (console.twilio.com -> Verify -> Services).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=
# Country code for numbers typed without one.
OTP_DEFAULT_COUNTRY=+91
# Local testing only: OTP_DEBUG=1 prints codes in the backend terminal instead of sending them.
OTP_DEBUG=

# Live mode voice (optional). Without a key, Live mode uses the device's built-in voice.
# Get a key at https://elevenlabs.io (Profile -> API keys, allow Text to Speech).
# Voice id: on the free plan use one of ElevenLabs' default voices, e.g.
#   Sarah EXAVITQu4vr4xnSDxMaL (default) · Jessica cgSgspJ2msm6clMCkdW9 · Alice Xb7hH8MSUJpSbSDYk0k2
#   River SAz9YHcvj6GT2YYXdXww · Brian nPczCjzI2devNBz1zQrb · George JBFqnCBsd6RMkjVDRZzb · Daniel onwK4e9ZLuTAKqWW03F9
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
