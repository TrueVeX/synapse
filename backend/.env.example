OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
TAVILY_API_KEY=
JWT_SECRET=replace-this-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
# Optional locally (uses synapse.db when empty). Required on Vercel:
# Supabase > Connect > Transaction pooler connection string (port 6543).
DATABASE_URL=
# Payments (Razorpay > Account & Settings > API Keys). Use rzp_test_ keys
# while testing; leave empty to show plans without taking payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Webhooks: URL https://<backend>/api/billing/webhook, events
# payment.captured, order.paid, subscription.activated, subscription.charged,
# subscription.cancelled, subscription.halted, and a secret you choose.
RAZORPAY_WEBHOOK_SECRET=
# Auto-pay: Razorpay > Subscriptions > Plans IDs (plan_...). When a plan's ID
# is set, buying it starts an auto-renewing subscription; when empty, it is
# a one-time payment for 30 / 365 days.
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_MAX_MONTHLY=
RAZORPAY_PLAN_MAX_ANNUAL=
# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type Web).
# The same value goes in frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
