OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
TAVILY_API_KEY=
JWT_SECRET=replace-this-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
# Optional locally (uses synapse.db when empty). Required on Vercel:
# Supabase > Connect > Transaction pooler connection string (port 6543).
DATABASE_URL=
# Payments (Razorpay > Account & Settings > API Keys). Use rzp_test_ keys
# while testing; leave empty to show plans without taking payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay > Webhooks: URL https://<backend>/api/billing/webhook, events
# payment.captured and order.paid, and a secret you choose.
RAZORPAY_WEBHOOK_SECRET=
# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type Web).
# The same value goes in frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
