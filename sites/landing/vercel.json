{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/download", "destination": "/#download", "permanent": false },
    { "source": "/windows", "destination": "https://github.com/TrueVeX/synapse/releases/latest/download/SYNAPSE-Setup.exe", "permanent": false },
    { "source": "/android", "destination": "https://github.com/TrueVeX/synapse/releases/latest/download/SYNAPSE.apk", "permanent": false },
    { "source": "/app", "destination": "https://synapse-humanform.vercel.app", "permanent": false },
    { "source": "/docs", "destination": "https://synapse-humanform-docs.vercel.app", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
